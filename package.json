{
  "name": "flashify",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx apps/server/server.ts",
    "start": "node dist/apps/server/server.js",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
